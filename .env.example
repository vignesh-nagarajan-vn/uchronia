# Anthropic API key. Lives server-side only — never sent to the client, never logged.
# When absent (and UCHRONIA_MOCK is not set), the app falls back to mock mode with a warning.
ANTHROPIC_API_KEY=

# Set to 1 to force deterministic mock mode (no API key needed, full demo works).
# CI always runs with UCHRONIA_MOCK=1.
UCHRONIA_MOCK=

# Model routing overrides (defaults shown; see docs/GENERATION.md).
UCHRONIA_MODEL_GENERATION=claude-sonnet-4-6
UCHRONIA_MODEL_CRITIC=claude-haiku-4-5-20251001

# Server port (default 8787).
UCHRONIA_PORT=

# SQLite database file (default ./data/uchronia.db, relative to apps/server).
UCHRONIA_DB=
