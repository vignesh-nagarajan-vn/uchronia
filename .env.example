# Copy to .env at the repo root; `pnpm dev` / `pnpm dev:server` load it (real
# environment variables always win over this file). Unset lines stay commented
# out — an empty assignment (VAR=) means "unset" to the config parser too, but
# keeping them commented is clearer.

# Anthropic API key. Lives server-side only: never sent to the client, never logged.
# When absent (and UCHRONIA_MOCK is not set), the app falls back to mock mode with a warning.
# ANTHROPIC_API_KEY=

# Set to 1 to force deterministic mock mode (no API key needed, full demo works).
# CI always runs with UCHRONIA_MOCK=1.
# UCHRONIA_MOCK=1

# Model routing overrides (defaults shown; see docs/GENERATION.md). The
# generation model must support structured outputs.
# UCHRONIA_MODEL_GENERATION=claude-sonnet-5
# UCHRONIA_MODEL_CRITIC=claude-haiku-4-5-20251001

# Server port (default 8787).
# UCHRONIA_PORT=8787

# Interface the server binds (default 127.0.0.1: localhost only). Containers
# and LAN exposure need 0.0.0.0 — read SECURITY.md first; there is no auth.
# UCHRONIA_HOST=127.0.0.1

# SQLite database file (default ./data/uchronia.db, resolved absolute and
# logged at boot; /tmp/uchronia.db on serverless).
# UCHRONIA_DB=./data/uchronia.db

# Hard per-run token ceiling for live generation (input+output; default 3000000;
# 0 disables). The run aborts cleanly at the ceiling and can be continued.
# UCHRONIA_MAX_RUN_TOKENS=3000000

# Mock-mode demo pacing in ms per accepted event (default 0; pnpm dev:mock
# sets 250 so derivations visibly ink in; also 250 under Vercel). Ignored in
# live mode.
# UCHRONIA_MOCK_PACE_MS=250

# Serve the built web app from this directory (production single-container
# mode; see docs/DEPLOY.md). Leave unset in development; vite proxies /api.
# UCHRONIA_STATIC_DIR=

# Comma-separated CORS origin allowlist. Unset = same-origin only.
# UCHRONIA_CORS_ORIGINS=

# Seed the showcase chronicle into an empty database at boot. Defaults off
# locally and on under Vercel, where the database is ephemeral (/tmp).
# UCHRONIA_SEED_DEMO=1
