{
  "name": "uchronia",
  "private": true,
  "version": "2.0.0",
  "description": "An alternate-history engine - git rebase for history.",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @uchronia/server --filter @uchronia/web dev",
    "dev:mock": "cross-env UCHRONIA_MOCK=1 UCHRONIA_MOCK_PACE_MS=250 pnpm dev",
    "dev:preview": "cross-env UCHRONIA_MOCK=1 UCHRONIA_MOCK_PACE_MS=250 pnpm --parallel --filter @uchronia/server --filter @uchronia/web dev:preview",
    "dev:server": "pnpm --filter @uchronia/server dev",
    "dev:web": "pnpm --filter @uchronia/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "migrate": "pnpm --filter @uchronia/server migrate",
    "e2e": "pnpm --filter @uchronia/web e2e",
    "verify:vercel": "pnpm --filter @uchronia/server build:vercel && node scripts/verify-vercel.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "eval": "pnpm --filter @uchronia/evals eval",
    "eval:report": "pnpm --filter @uchronia/evals eval:report",
    "eval:live": "pnpm --filter @uchronia/evals eval:live",
    "eval:critic": "pnpm --filter @uchronia/evals eval:critic"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "cross-env": "^7.0.3"
  }
}
