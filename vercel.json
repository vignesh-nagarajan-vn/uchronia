{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack enable && corepack prepare pnpm@11.16.0 --activate && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @uchronia/web build && node -e \"require('node:fs').cpSync('apps/web/dist','dist',{recursive:true})\"",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{apps/server/drizzle,demo}/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
