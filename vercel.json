{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install -g pnpm@11.16.0 && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @uchronia/server build:vercel && pnpm --filter @uchronia/web build && node scripts/mirror-dist.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "apps/server/dist/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
